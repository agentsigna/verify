{
  "name": "@agentsigna/verify",
  "version": "1.1.1",
  "description": "Standalone offline verifier for AgentSigna Action Authorization Passports and Ledger Chains. No AgentSigna API dependency.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/write-esm-package-json.cjs",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/index.test.js",
    "pack:check": "npm run test && npm pack --dry-run"
  },
  "keywords": [
    "agentsigna",
    "passport",
    "authorization",
    "ai-agent",
    "audit",
    "ledger",
    "ed25519",
    "verification"
  ],
  "license": "MIT",
  "author": "AuthorityMesh Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentsigna/verify.git"
  },
  "homepage": "https://github.com/agentsigna/verify#readme",
  "bugs": {
    "url": "https://github.com/agentsigna/verify/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "typescript": "6.0.3"
  }
}
